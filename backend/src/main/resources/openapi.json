{
  "openapi": "3.1.0",
  "info": {
    "title": "Schedula API",
    "version": "0.1.0",
    "description": "Sessão HttpOnly e CSRF. Obtenha token/header em /api/auth/csrf antes de POST/DELETE. Atualize o token após login/logout. Horários em America/Fortaleza."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "schemas": {
      "Municipality": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "stateCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "required": [
          "name",
          "stateCode"
        ]
      },
      "Unit": {
        "type": "object",
        "required": [
          "municipalityId",
          "stateCode",
          "name",
          "areas",
          "phone",
          "postalCode",
          "street",
          "streetNumber",
          "neighborhood"
        ],
        "properties": {
          "municipalityId": {
            "type": "string",
            "format": "uuid"
          },
          "stateCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "areas": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "enum": [
                "CIVEL",
                "CRIMINAL"
              ]
            }
          },
          "phone": {
            "type": "string",
            "maxLength": 20
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "postalCode": {
            "type": "string",
            "pattern": "^[0-9]{5}-?[0-9]{3}$"
          },
          "street": {
            "type": "string",
            "maxLength": 150
          },
          "streetNumber": {
            "type": "string",
            "maxLength": 20
          },
          "complement": {
            "type": "string",
            "maxLength": 100
          },
          "neighborhood": {
            "type": "string",
            "maxLength": 100
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "Defender": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "name"
        ]
      },
      "Affiliation": {
        "type": "object",
        "properties": {
          "defenderId": {
            "type": "string",
            "format": "uuid"
          },
          "unitId": {
            "type": "string",
            "format": "uuid"
          },
          "area": {
            "type": "string",
            "enum": [
              "CIVEL",
              "CRIMINAL"
            ]
          }
        },
        "required": [
          "defenderId",
          "unitId",
          "area"
        ]
      },
      "Publish": {
        "type": "object",
        "properties": {
          "affiliationId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "start": {
            "type": "string",
            "format": "time"
          },
          "end": {
            "type": "string",
            "format": "time"
          },
          "minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 240
          },
          "repeatUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "required": [
          "affiliationId",
          "date",
          "start",
          "end",
          "minutes"
        ]
      },
      "Block": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "maxLength": 250
          }
        },
        "required": [
          "start",
          "end",
          "reason"
        ]
      },
      "Reschedule": {
        "type": "object",
        "properties": {
          "slotId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "slotId"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "COMPARECEU",
              "REALIZADO",
              "NAO_COMPARECEU"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ActivationToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ]
      },
      "Activation": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "confirmation": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "token",
          "password",
          "confirmation"
        ]
      },
      "PasswordChange": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "confirmation": {
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "currentPassword",
          "password",
          "confirmation"
        ]
      }
    }
  },
  "paths": {
    "/api/rh/municipalities": {
      "get": {
        "summary": "RH: listar municipalities",
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Perfil ou CSRF inválido"
          },
          "409": {
            "description": "Conflito de regra de negócio"
          }
        }
      },
      "post": {
        "summary": "RH: cadastrar municipalities",
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Perfil ou CSRF inválido"
          },
          "409": {
            "description": "Conflito de regra de negócio"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Municipality"
              }
            }
          }
        },
        "deprecated": true,
        "description": "Compatibilidade legada; não marca catálogo completo. O painel usa o catálogo IBGE."
      }
    },
