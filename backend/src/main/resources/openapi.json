    "/api/auth/login": {
      "post": {
        "summary": "Autenticar com formulário e CSRF",
        "responses": {
          "200": {
            "description": "Operação concluída"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Perfil ou CSRF inválido"
          },
          "409": {
            "description": "Conflito de regra de negócio"
          },
          "204": {
            "description": "Sessão autenticada"
          },
          "429": {
            "description": "Limite por endereço atingido",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Segundos até nova tentativa"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
